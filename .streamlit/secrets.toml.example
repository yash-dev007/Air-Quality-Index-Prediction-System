# Rename this file to secrets.toml and fill in your keys.
# In Streamlit Cloud: paste these under App Settings > Secrets.

# OpenWeatherMap free API key (optional — enables weather features)
# Sign up at https://openweathermap.org/api
OWM_API_KEY = "your_openweathermap_api_key_here"

# Email alert credentials (optional — used by aqi_alert.py)
ALERT_EMAIL    = "your_email@gmail.com"
ALERT_PASSWORD = "your_gmail_app_password"
ALERT_TO       = "recipient@gmail.com"
